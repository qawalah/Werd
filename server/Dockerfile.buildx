# For developers: multi-platform image from dist/linux with docker buildx (used to make the importable image files).
#   docker buildx build -f Dockerfile.buildx --platform linux/amd64,linux/arm64,linux/arm/v7 -t werd-server:1.4.0 .
# For a NAS, use docker-compose.yml + Dockerfile instead (they pick the right binary automatically).
FROM gcr.io/distroless/static-debian12
ARG TARGETARCH
ARG TARGETVARIANT
COPY dist/linux/werd-server-linux-${TARGETARCH}${TARGETVARIANT} /werd-server
ENV WERD_DATA=/data WERD_ADDR=:8080 WERD_DOCKER=1
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/werd-server", "healthcheck"]
ENTRYPOINT ["/werd-server"]
LABEL org.opencontainers.image.title="Werd Server" \
      org.opencontainers.image.description="Shared library and family features for the Werd app" \
      org.opencontainers.image.version="1.4.0"
